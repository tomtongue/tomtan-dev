---
import type { MarkdownHeading } from 'astro';

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
    items.length > 0 && (
        <nav class="toc" aria-label="On this page">
            <p class="toc-title">On this page</p>
            <ul class="toc-list">
                {items.map((h) => (
                    <li class={`toc-item toc-depth-${h.depth}`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}

<style>
.toc {
    font-family: var(--font-primary);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--toc-text, #6b7280);
}

.toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
    color: var(--toc-title, #374151);
}

.toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--toc-border, #e5e7eb);
}

.toc-item {
    margin: 0;
}

.toc-item a {
    display: block;
    padding: 0.3rem 0.75rem;
    color: var(--toc-link, #6b7280);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 0.15s ease, border-color 0.15s ease;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.toc-item a:hover {
    color: var(--toc-link-hover, #111827);
}

.toc-item.is-active > a {
    color: var(--toc-active, #0070c9);
    border-left-color: var(--toc-active, #0070c9);
}

.toc-depth-3 > a {
    padding-left: 1.75rem;
    font-size: 0.8125rem;
}

@media (prefers-color-scheme: dark) {
    .toc { color: #9ca3af; }
    .toc-title { color: #d1d5db; }
    .toc-list { border-left-color: #374151; }
    .toc-item a { color: #9ca3af; }
    .toc-item a:hover { color: #f3f4f6; }
    .toc-item.is-active > a {
        color: #4ba1ff;
        border-left-color: #4ba1ff;
    }
}
</style>

<script>
    const initToc = () => {
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>('.toc-item > a'),
        );
        if (links.length === 0) return;

        const itemBySlug = new Map<string, HTMLElement>();
        links.forEach((a) => {
            const id = decodeURIComponent(
                (a.getAttribute('href') ?? '').replace(/^#/, ''),
            );
            const li = a.parentElement;
            if (id && li) itemBySlug.set(id, li);
        });

        const headingEls = Array.from(itemBySlug.keys())
            .map((id) => document.getElementById(id))
            .filter((el): el is HTMLElement => el !== null);
        if (headingEls.length === 0) return;

        const setActive = (id: string) => {
            itemBySlug.forEach((li) => li.classList.remove('is-active'));
            itemBySlug.get(id)?.classList.add('is-active');
        };

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries.filter((e) => e.isIntersecting);
                if (visible.length === 0) return;
                const top = visible.reduce((a, b) =>
                    a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
                );
                if (top.target.id) setActive(top.target.id);
            },
            { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
        );

        headingEls.forEach((h) => observer.observe(h));
    };

    initToc();
    document.addEventListener('astro:page-load', initToc);
</script>
