---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/ttomtan', icon: 'linkedin-logo' },
	{ label: 'GitHub', href: 'https://github.com/tomtongue/tomtan-dev', icon: 'github-logo' },
];
---

<nav class="nav-container" id="main-nav">
    <div class="nav-content">
        <a href="/" class="nav-logo">
            <span class="nav-title">tomtan.dev</span>
        </a>

        <div class="nav-links">
            <a href="/tags" class="nav-link">Tags</a>
        </div>

        <div class="nav-social">
            {iconLinks.map(({ href, icon, label }) => (
                <a href={href} class="social-link" target="_blank" rel="noopener">
                    <span class="sr-only">{label}</span>
                    <Icon icon={icon} size="1.25em" />
                </a>
            ))}
        </div>

        <button class="mobile-menu-button" aria-label="Menu" aria-expanded="false">
            <Icon icon="list" size="1.25em" />
        </button>
    </div>

    <div class="mobile-menu" hidden>
        <div class="mobile-links">
            <a href="/tags" class="mobile-link">Tags</a>
        </div>
        <div class="mobile-social">
            {iconLinks.map(({ href, icon, label }) => (
                <a href={href} class="social-link" target="_blank" rel="noopener">
                    <span class="sr-only">{label}</span>
                    <Icon icon={icon} size="1.5em" />
                </a>
            ))}
        </div>
    </div>
</nav>

<script>

let lastScroll = 0;
const scrollThreshold = 50;
const scrollDeltaThreshold = 5;

function handleScroll() {
    const nav = document.getElementById('main-nav');
    if (!nav) return;

    const currentScroll = window.scrollY;
    const scrollDelta = Math.abs(currentScroll - lastScroll);

    if (scrollDelta > scrollDeltaThreshold) {
        if (currentScroll <= 10) {
            nav.classList.remove('nav-hidden');
            nav.classList.remove('nav-scrolled');
        }
        else if (currentScroll > lastScroll && currentScroll > scrollThreshold) {
            nav.classList.add('nav-hidden');
            nav.classList.add('nav-scrolled');
        }
        else if (currentScroll < lastScroll) {
            nav.classList.remove('nav-hidden');
            nav.classList.add('nav-scrolled');
        }

        lastScroll = currentScroll;
    }
}

let scrollTimeout: number | undefined;
window.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = window.setTimeout(handleScroll, 10);
});

function toggleMenu(event: Event) {
    event.preventDefault();
    event.stopPropagation();

    const menuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu') as HTMLElement | null;

    if (!menuButton || !mobileMenu) return;

    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu.hidden = isExpanded;
}

function setupMenu() {
    document.querySelector('.mobile-menu-button')?.addEventListener('click', toggleMenu);
}

document.addEventListener('astro:page-load', setupMenu);
</script>

<style>
.nav-container {
    position: fixed;
    top: calc(0.75rem + env(safe-area-inset-top, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    transition: transform 0.3s ease, top 0.3s ease, opacity 0.3s ease;
    min-width: 420px;
    width: auto;
    max-width: 600px;
}

.nav-scrolled {
    top: 0.5rem;
}

.nav-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-20px);
}

.nav-content {
    height: 2.5rem;
    padding: 0.375rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.28)),
        rgba(245, 245, 247, 0.38);
    -webkit-backdrop-filter: blur(24px) saturate(180%) contrast(105%);
    backdrop-filter: blur(24px) saturate(180%) contrast(105%);
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.72),
        inset 0 -1px 0 rgba(0, 0, 0, 0.05),
        0 8px 24px rgba(31, 35, 48, 0.12),
        0 2px 6px rgba(31, 35, 48, 0.08);
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
}

.nav-title {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Google Sans", "Helvetica Neue", sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}

@media (max-width: 768px) {
    .nav-title {
        font-size: 1rem;
    }
}

.nav-links {
    display: flex;
    gap: 1rem;
    margin: 0;
}

.nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease;
    border-radius: 0.5rem;
}

.nav-link:hover {
    color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0.05);
}

@media (prefers-color-scheme: dark) {
    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }
}

.nav-social {
    display: flex;
    gap: 0.5rem;
}

.social-link {
    color: var(--text-secondary);
    transition: color 0.2s ease;
    padding: 0.25rem;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.social-link:hover {
    color: var(--primary-color);
}

.mobile-menu-button {
    display: none;
    background: none;
    border: none;
    padding: 0.75rem;
    color: var(--text-primary);
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
}

.mobile-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.38)),
        rgba(245, 245, 247, 0.48);
    -webkit-backdrop-filter: blur(24px) saturate(180%) contrast(105%);
    backdrop-filter: blur(24px) saturate(180%) contrast(105%);
    padding: 1rem 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.7),
        inset 0 -1px 0 rgba(0, 0, 0, 0.05),
        0 12px 32px rgba(31, 35, 48, 0.14);
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

@media (max-width: 768px) {
    .nav-container {
        min-width: unset;
        width: calc(100% - 3rem);
        max-width: calc(100% - 3rem);
    }

    .nav-content {
        padding: 0.375rem 0.75rem;
        gap: 0.75rem;
    }

    .nav-links,
    .nav-social {
        display: none;
    }

    .mobile-menu-button {
        display: block;
    }

    .mobile-menu:not([hidden]) {
        display: block;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1rem;
        align-items: center;
    }

    .mobile-link {
        text-decoration: none;
        color: var(--text-primary);
        font-size: 1.125rem;
        font-weight: 500;
        padding: 0.5rem;
        text-align: center;
    }

    .mobile-social {
        display: flex;
        justify-content: center;
        gap: 1rem;
        padding: 1rem 0;
    }
}

@media (prefers-color-scheme: dark) {
    .nav-content {
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.025)),
            rgba(24, 24, 26, 0.46);
        border-color: rgba(255, 255, 255, 0.16);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.14),
            inset 0 -1px 0 rgba(0, 0, 0, 0.28),
            0 10px 28px rgba(0, 0, 0, 0.34),
            0 2px 8px rgba(0, 0, 0, 0.28);
    }

    .mobile-menu {
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.025)),
            rgba(24, 24, 26, 0.56);
        border-color: rgba(255, 255, 255, 0.16);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.14),
            inset 0 -1px 0 rgba(0, 0, 0, 0.28),
            0 14px 36px rgba(0, 0, 0, 0.4);
    }
}

@media (prefers-reduced-motion: reduce) {
    .nav-container {
        transition: none;
    }
}
</style>
