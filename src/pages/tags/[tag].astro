---
import { getPublishedPosts } from '../../lib/blog';
import TagView from '../../layouts/TagView.astro';
import GridView from '../../components/GridView.astro';
import BlogEntries from '../../components/BlogEntries.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
    const posts = await getPublishedPosts();
    const tags = [...new Set(posts.flatMap(post => post.data.tags))];
    
    return tags.map(tag => ({
        params: { tag },
        props: {
            posts: posts.filter(post => post.data.tags.includes(tag))
        }
    }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<TagView
    title={`${tag} Posts`}
    description={`Articles and blog posts about ${tag}`}
    heading={tag!}
    subtitle={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'} with this tag`}
>
    <section class="posts-section">
        <GridView>
            {posts.map((post) => <BlogEntries post={post} />)}
        </GridView>
    </section>

    <section class="related-tags">
        <h2>Tags</h2>
        <div class="tag-list">
            <a href="/tags" class="tag-item view-all">
                <Icon icon="list" size="0.85em" />
                <span>View all tags</span>
            </a>
        </div>
    </section>
</TagView>

<style>
    .posts-section {
        margin-bottom: 4rem;
    }

    .related-tags {
        margin-bottom: 4rem;
    }

    .related-tags h2 {
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--text-primary, #1d1d1f);
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    
    .tag-item {
        display: inline-block;
        background: var(--background, #f5f5f7);
        color: var(--text-secondary, #666666);
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }
    
    .tag-item:hover {
        background-color: var(--border-color, #e5e5e5);
    }
</style>
