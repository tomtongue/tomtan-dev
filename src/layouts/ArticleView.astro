---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

import FormattedDateUtil from '../components/FormattedDateUtil.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Icon from '../components/Icon.astro';


type Props = CollectionEntry<'blog'>['data'] & {
    headings?: MarkdownHeading[];
};

const { title, description, tags, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<div class="article-layout">
    <article class="content">
        <h1>{title}</h1>
        <div class="article-meta">
            <FormattedDateUtil date={pubDate} />
            <div class="article-tags">
                {
                    tags.map((tag) => (
                    <a href={`/tags/${tag}`} class="article-tag">
                        {tag}
                    </a>))
                }
            </div>
        </div>
        {
            updatedDate && (
                <div class="last-updated-on">
                    Last updated on <FormattedDateUtil date={updatedDate} />
                </div>
            )
        }
        {
            heroImage && (
                <div class="hero-image-container">
                    <img
                        src={heroImage}
                        alt={title}
                        class="hero-image"
                        loading="eager"
                    />
                </div>
            )
        }
        <slot />
    </article>
    {
        tocHeadings.length > 0 && (
            <>
                <button
                    type="button"
                    class="toc-toggle"
                    aria-label="Toggle table of contents"
                    aria-controls="toc-panel"
                    aria-expanded="false"
                    data-toc-toggle
                >
                    <Icon icon="list" size="1.25rem" />
                </button>
                <aside class="toc-aside" id="toc-panel">
                    <div class="toc-sticky">
                        <TableOfContents headings={headings} />
                    </div>
                </aside>
            </>
        )
    }
</div>

<style>
.article-layout {
    display: block;
}

/* Smooth morph when the TOC is toggled. View transition snapshots the
   article and TOC, then animates between the closed and open layouts. */
.article-layout > .content {
    view-transition-name: article-main;
}

.article-layout > .toc-aside {
    view-transition-name: article-toc;
}

::view-transition-old(article-main),
::view-transition-new(article-main),
::view-transition-old(article-toc),
::view-transition-new(article-toc) {
    animation-duration: 0.28s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
}

.content {
    --content-width: 65rem;
    --content-padding: 3rem;
    --text-color: #333333;
    --heading-color: #000000;
    --link-color: #0070c9;
    --code-background: #f6f8fa;
    --background: #f6f8fa;
    --blockquote-border: #e0e0e0;
    --table-border: #e0e0e0;
    --nav-height: 4rem;
    --safe-padding-top: calc(var(--nav-height) + 2rem + env(safe-area-inset-top, 0px));

    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--safe-padding-top) var(--content-padding) 0;
    font-family: var(--font-primary);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-color);
}

.content :global(h2),
.content :global(h3) {
    scroll-margin-top: calc(4rem + 1rem + env(safe-area-inset-top, 0px));
}

.toc-aside {
    display: none;
}

.toc-toggle {
    display: none;
    position: fixed;
    top: calc(4rem + 0.75rem + env(safe-area-inset-top, 0px));
    right: 1rem;
    z-index: 20;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--toc-toggle-border, #e5e7eb);
    background: var(--toc-toggle-bg, #f6f8fa);
    color: var(--toc-toggle-fg, #333333);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.toc-toggle:hover {
    background: var(--toc-toggle-bg-hover, #eef1f5);
}

.toc-toggle[aria-expanded="true"] {
    background: var(--toc-active, #0070c9);
    border-color: var(--toc-active, #0070c9);
    color: #ffffff;
}

@media (min-width: 900px) and (max-width: 1499px) {
    .toc-toggle {
        display: inline-flex;
    }

    /* When the user opens the TOC on a medium-width viewport, switch to a
       two-column push layout. The pair is centered together so that wider
       viewports inside this range don't right-align the content. */
    .article-layout[data-toc-open="true"] {
        display: grid;
        grid-template-columns: minmax(0, 55rem) 14rem;
        column-gap: 2rem;
        justify-content: center;
        align-items: start;
        padding: 0 1.5rem;
    }

    .article-layout[data-toc-open="true"] > .content {
        grid-column: 1;
        max-width: none;
        margin: 0;
        padding-left: 0;
        padding-right: 0;
    }

    .article-layout[data-toc-open="true"] > .toc-aside {
        display: block;
        grid-column: 2;
        padding-top: calc(4rem + 2rem + env(safe-area-inset-top, 0px));
        align-self: stretch;
    }

    .article-layout[data-toc-open="true"] .toc-sticky {
        position: sticky;
        top: calc(4rem + 1rem);
        max-height: calc(100vh - 4rem - 2rem);
        overflow-y: auto;
        padding-right: 0.25rem;
    }
}

@media (prefers-color-scheme: dark) {
    .toc-toggle {
        background: #303031;
        border-color: #424242;
        color: #e0e0e0;
    }

    .toc-toggle:hover {
        background: #3a3a3b;
    }

    .toc-toggle[aria-expanded="true"] {
        background: #4ba1ff;
        border-color: #4ba1ff;
        color: #ffffff;
    }
}

@media (min-width: 1500px) {
    /* Three-column grid with a phantom left column the same width as the TOC,
       so the article column is visually centered in the viewport. */
    .article-layout {
        display: grid;
        grid-template-columns: 14rem minmax(0, 55rem) 14rem;
        column-gap: 2rem;
        justify-content: center;
        align-items: start;
        padding: 0 1.5rem;
    }

    .article-layout > .content {
        grid-column: 2;
        max-width: none;
        margin: 0;
        padding-left: 0;
        padding-right: 0;
    }

    .toc-aside {
        display: block;
        grid-column: 3;
        padding-top: calc(4rem + 2rem + env(safe-area-inset-top, 0px));
        align-self: stretch;
    }

    .toc-sticky {
        position: sticky;
        top: calc(4rem + 1rem);
        max-height: calc(100vh - 4rem - 2rem);
        overflow-y: auto;
        padding-right: 0.25rem;
    }
}

@media (min-width: 1700px) {
    .article-layout {
        grid-template-columns: 16rem minmax(0, 65rem) 16rem;
        column-gap: 3rem;
    }
}

/* h1 margin adjustment */
.content h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1.5rem;
    color: var(--heading-color);
    letter-spacing: -0.02em;
}

.content :global(a) {
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    display: inline-block;
}

.content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    table-layout: fixed;
}

.content :global(table th),
.content :global(table td) {
    padding: 0.75rem;
    border: 1px solid var(--table-border, #e0e0e0);
    text-align: left;
    vertical-align: top;
    
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    min-width: 100px;
}

.content :global(table th) {
    font-weight: 600;
}

.content :global(pre) {
    line-height: 1.4;
}

.content :global(pre code) {
    line-height: 1.4;
}

.content :global(code) {
    line-height: 1.4;
}

.article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}


.last-updated-on {
    color: var(--text-secondary, #cfcfcf);
    font-size: 0.875rem;
    margin: 0.5rem 0;
}

.article-tags {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}


.article-tag {
    background: var(--background);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    border: 0.5px solid var(--tag-border, rgba(0, 0, 0, 0.05));
    font-size: 0.9rem;
}

@media (max-width: 1600px) {
    .content {
        --content-width: 55rem;
        --content-padding: 2rem;
    }
}

@media (max-width: 1200px) {
    .content {
        --content-width: 45rem;
        --content-padding: 1.5rem;
        --safe-padding-top: calc(var(--nav-height) + 1.5rem + env(safe-area-inset-top, 0px));
    }

    .content h1 { font-size: 2.5rem; }
}

@media (max-width: 768px) {
    .content {
        --content-padding: 1rem;
        --safe-padding-top: calc(var(--nav-height) + 1rem + env(safe-area-inset-top, 0px));
        font-size: 1.0625rem;
    }

    .content h1 { font-size: 2.125rem; }

    .content :global(h2) {
        font-size: 1.625rem;
    }

    .content :global(h3) {
        font-size: 1.375rem;
    }

    .content :global(p),
    .content :global(li) {
        font-size: 1.0625rem;
    }

    .content :global(table) {
        font-size: 0.9375rem;
    }

    .content :global(table th),
    .content :global(table td) {
        padding: 0.625rem var(--content-padding);
    }
}

@media (prefers-color-scheme: dark) {
    .content {
        --text-color: #e0e0e0;
        --heading-color: #ffffff;
        --link-color: #4ba1ff;
        --code-background: #303031;
        --blockquote-border: #424242;
        --table-border: #424242;
        --background: #303031;
    }

    .tags {
        background: var(--code-background);
        color: var(--text-color);
    }
}

.hero-image-container {
    margin: 2rem 0;
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--code-background);
    display: flex;
    align-items: center;
    justify-content: center;
}

.hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center center;
    max-height: 500px;
}

@media (max-width: 768px) {
    .hero-image-container {
        margin: 1.5rem 0;
        border-radius: 0.5rem;
    }

    .hero-image {
        max-height: 300px;
    }
}

@media print {
    .content {
        --content-width: 100%;
        --content-padding: 0;
        --safe-padding-top: 0;
    }

    .hero-image-container {
        page-break-inside: avoid;
    }

    .toc-toggle,
    .toc-aside {
        display: none !important;
    }
}
</style>

<script>
    const STORAGE_KEY = 'tocOpen';

    const readStored = (): boolean => {
        try {
            return localStorage.getItem(STORAGE_KEY) === 'true';
        } catch {
            return false;
        }
    };

    const writeStored = (open: boolean) => {
        try {
            localStorage.setItem(STORAGE_KEY, open ? 'true' : 'false');
        } catch {
            /* ignore quota / privacy mode errors */
        }
    };

    const applyState = (open: boolean) => {
        document.querySelectorAll<HTMLElement>('.article-layout').forEach((el) => {
            el.setAttribute('data-toc-open', open ? 'true' : 'false');
        });
        document.querySelectorAll<HTMLButtonElement>('[data-toc-toggle]').forEach((btn) => {
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    };

    const syncFromStorage = () => applyState(readStored());

    type ViewTransitionDoc = Document & {
        startViewTransition?: (cb: () => void) => unknown;
    };

    const runWithTransition = (cb: () => void) => {
        const vt = (document as ViewTransitionDoc).startViewTransition;
        if (typeof vt === 'function' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            vt.call(document, cb);
        } else {
            cb();
        }
    };

    if (!document.documentElement.hasAttribute('data-toc-listener')) {
        document.documentElement.setAttribute('data-toc-listener', '');
        document.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement | null)?.closest('[data-toc-toggle]');
            if (!btn) return;
            const layout = document.querySelector<HTMLElement>('.article-layout');
            const next = layout?.getAttribute('data-toc-open') !== 'true';
            runWithTransition(() => {
                applyState(next);
                writeStored(next);
            });
        });
    }

    syncFromStorage();
    document.addEventListener('astro:page-load', syncFromStorage);
</script>